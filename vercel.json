{
  "services": {
    "backend": {
      "root": "backend_reference/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "frontend": {
      "root": "./",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
