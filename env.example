# Copy this file to .env.local (same folder), then restart `npm run dev`.
# Use the real Python backend instead of demo samples:
NEXT_PUBLIC_BACKEND_MODE=live
# Where the Python (FastAPI) server is running:
BACKEND_URL=http://localhost:8000
# Optional shared secret sent as the x-api-key header:
# BACKEND_API_KEY=
#
# The Python backend's own secrets go in backend_reference/.env.local (and Vercel env vars), not here:
#   AWS_BEARER_TOKEN_BEDROCK=   Bedrock API key
#   AWS_REGION=us-east-1
#   BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-5   (optional)
