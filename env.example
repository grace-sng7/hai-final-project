# Copy this file to .env.local (same folder), then restart `npm run dev`.
# Offline demo: saved extraction examples + the real local Python calculator.
# Set to live to use provider-backed extraction and corrections.
NEXT_PUBLIC_BACKEND_MODE=offline
# Where the Python (FastAPI) server is running:
BACKEND_URL=http://localhost:8000
# Optional shared secret sent as the x-api-key header:
# BACKEND_API_KEY=
